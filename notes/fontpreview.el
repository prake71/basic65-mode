(defun petscii-show-char (code)
  "Show the PETSCII character for a given petcat control CODE."
  (interactive
   (list (completing-read "Enter petcat control code: " (mapcar #'car petscii-control-code-table))))
  (let ((char-code (cdr (assoc code petscii-control-code-table))))
    (if char-code
        (message "PETSCII character for %s: %c (code %d)" code char-code char-code))))


