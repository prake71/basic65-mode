(defun petscii-insert-unicode-char (code)
  "Insert the Unicode character for a given petcat control CODE using C64 Pro Mono font."
  (interactive
   (list (completing-read "Enter petcat control code: " (mapcar #'car petscii-petcat-table))))
  (let* ((petscii (cdr (assoc code petscii-petcat-table)))
         (unicode (+ #xEF40 petscii)))
    (if petscii
        (insert (char-to-string unicode))
      (message "Unknown control code: %s" code))))
