  '(("{clr}"     . 147)
    ("{home}"    . 19)
    ("{inst-del}". 20)
    ("{return}"  . 13)
    ("{rvs-on}"  . 18)
    ("{rvs-off}" . 146)
    ("{pi}"      . 255)
    ("{up}"      . 145)
    ("{down}"    . 17)
    ("{left}"    . 157)
    ("{right}"   . 29)
    ("{stop}"    . 3)
    ("{runstop}" . 5)
    ("{quote}"   . 34)
    ("{pound}"   . 156)
    ("{asterisk}". 42)
    ("{arrow}"   . 30)
