  '(("{clr}"     . 147)
    ("{home}"    . 19)
    ("{inst-del}". 20)
    ("{return}"  . 13)
    ("{rvs-on}"  . 18)
    ("{rvs-off}" . 146)
    ("{pi}"      . 255)
