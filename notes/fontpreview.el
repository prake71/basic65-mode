(defun petscii-font-preview ()
  "Create a buffer showing all PETSCII characters using C64 Pro Mono font."
  (interactive)
  (let ((buf (get-buffer-create "*PETSCII Font Preview*")))
    (with-current-buffer buf
      (erase-buffer)
      (dotimes (row 16)
        (dotimes (col 16)
          (insert (format "%c " (+ (* row 16) col))))
        (insert "\n"))
      (setq buffer-read-only t)
      (face-remap-add-relative 'default :family "C64 Pro Mono" :height 120)
      (goto-char (point-min)))
    (switch-to-buffer buf)))


